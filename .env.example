# Скопируй в .env: uv run --env-file .env celery -A ochered.celery_app worker --loglevel=INFO
OCHERED_REDIS_URL=redis://localhost:6379/0
OCHERED_BROKER_URL=redis://localhost:6379/1
OCHERED_RESULT_BACKEND=redis://localhost:6379/2
OCHERED_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/postgres
